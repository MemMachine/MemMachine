# --- Gemini (required) ---
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_MODEL=gemini-3.5-flash

# --- MemMachine backend ---
MEMORY_BACKEND_URL=http://localhost:8080

# --- Memory scope ---
GOOGLE_ADK_ORG_ID=google_adk_org
GOOGLE_ADK_PROJECT_ID=google_adk_project
# Optional scope / search filters (leave unset to omit)
# GOOGLE_ADK_GROUP_ID=
# GOOGLE_ADK_AGENT_ID=
GOOGLE_ADK_USER_ID=demo_user
# GOOGLE_ADK_SESSION_ID=
